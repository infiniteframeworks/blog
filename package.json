{
  "name": "and-beyond",
  "version": "1.0.0",
  "private": true,
  "description": "And Beyond — the Infinite Frameworks blog, built with Eleventy.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "eleventy --serve",
    "dev": "eleventy --serve",
    "build": "cross-env ELEVENTY_ENV=production eleventy",
    "build:dev": "eleventy",
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\"",
    "test": "node --test tests/*.test.js",
    "check": "npm run clean && npm run build && npm test"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "cross-env": "^7.0.3",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "prismjs": "^1.30.0",
    "sass": "^1.108.1"
  }
}
